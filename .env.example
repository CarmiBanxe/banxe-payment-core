# banxe-payment-core — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Hyperswitch (Sprint 9) ────────────────────────────────────────────────────
HYPERSWITCH_BASE_URL=http://localhost:8096
HYPERSWITCH_API_KEY=your_hyperswitch_api_key

# ── Paymentology (Sprint 10) ──────────────────────────────────────────────────
PAYMENTOLOGY_BASE_URL=https://api.paymentology.com
PAYMENTOLOGY_API_KEY=your_paymentology_api_key
PAYMENTOLOGY_PROGRAM_ID=your_mastercard_bin_program_id

# ── Midaz Ledger (already Sprint 8) ──────────────────────────────────────────
MIDAZ_BASE_URL=http://localhost:8095
MIDAZ_API_KEY=your_midaz_api_key
MIDAZ_ORG_ID=your_midaz_org_id
MIDAZ_LEDGER_ID=your_midaz_ledger_id

# ── Compliance API (banxe-emi-stack) ─────────────────────────────────────────
COMPLIANCE_API_URL=http://localhost:8093

# ── ClickHouse (audit trail I-24) ─────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=banxe_payment_audit
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
