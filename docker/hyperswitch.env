# Hyperswitch Environment Variables — Sprint 9 P0 Fix
# This file documents env overrides for juspay/hyperswitch docker-compose
# on GMKtec server (Tailscale VPN).
#
# USAGE on GMKtec:
#   cd ~/hyperswitch
#   cp ~/banxe-payment-core/docker/hyperswitch.env .env
#   docker compose --env-file .env up -d
#
# ─── P0 FIX: Hyperswitch App Server :8096 (Exited 101) ───
# Error: "database name must not be empty"
# Root cause: DATABASE_URL not set in environment
#
DATABASE_URL=postgresql://db_user:db_pass@pg:5432/hyperswitch_db

# ─── P0 FIX: Hyperswitch Card Vault :8098 (Exited 101) ───
# Error: "missing field 'port'"
# Root cause: LOCKER__DATABASE__PORT not set
# Ref: https://github.com/juspay/hyperswitch-card-vault/blob/main/docs/guides/setup.md
#
LOCKER__SERVER__HOST=0.0.0.0
LOCKER__SERVER__PORT=8080
LOCKER__DATABASE__HOST=pg
LOCKER__DATABASE__PORT=5432
LOCKER__DATABASE__USERNAME=db_user
LOCKER__DATABASE__PASSWORD=db_pass
LOCKER__DATABASE__DBNAME=hyperswitch_vault
LOCKER__LOG__CONSOLE__ENABLED=true
LOCKER__LOG__CONSOLE__LEVEL=DEBUG
LOCKER__LOG__CONSOLE__LOG_FORMAT=default
LOCKER__LIMIT__REQUEST_COUNT=100
LOCKER__LIMIT__DURATION=60

# ─── Port Remapping (ADR-015 / SERVICE-MAP) ───
# These are applied via sed commands in docker-compose.yml comments:
#   App Server:      8096 (remapped from 8080)
#   Control Center:  8097 (remapped from 9000)
#   Web SDK:         9050 (no remap)
#   PG (internal):   5434 (remapped from 5432)
#   Redis (internal):6380 (remapped from 6379)
#
# ─── IMPORTANT ───
# 1. Replace db_user/db_pass with actual credentials from GMKtec
# 2. LOCKER__SECRETS__LOCKER_PRIVATE_KEY must be set separately (sensitive)
# 3. See docs/MIGRATION-TRIBE-TO-COMPOSABLE.md for full architecture
